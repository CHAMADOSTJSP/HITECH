# Desenvolvimento local. Gere uma chave aleatória (>= 32 caracteres) e nunca publique segredos reais.
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=
DATABASE_URL=sqlite:///./voltguard.db
SIMULATE_TELEMETRY=0
# Só ative atrás de um proxy confiável (Render): usa o IP real do cliente nos limites de requisição.
TRUST_PROXY=0
# Dias de retenção do histórico de telemetria (mínimo 7).
HISTORY_RETENTION_DAYS=180
# Segundos sem telemetria até o dispositivo ser considerado OFFLINE (30 a 86400).
DEVICE_OFFLINE_AFTER_SECONDS=300
